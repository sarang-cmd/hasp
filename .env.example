# Hasp environment. Copy to .env and fill in. Never commit .env.
#
# These variables are read by server.mjs. None of them are build arguments, so none
# of them end up in a client bundle.

# ------------------------------------------------------------------ logo.dev
# The SECRET key (sk_). Used only by the server, in the /api/logo proxy. It is
# never sent to the browser: the client asks /api/logo?host=groq.com and the server
# adds the token. Putting an sk_ key in a page would let anyone read it.
#
# Optional. With no key set, the proxy reports not_configured and the app uses its
# 586 vendored marks instead.
LOGO_DEV_KEY=

# The PUBLISHABLE key (pk_). Safe in a browser, and only needed if a surface calls
# logo.dev directly rather than through the proxy. Empty by default.
LOGO_DEV_PUBLIC_KEY=

# ------------------------------------------------------------------- runtime
# Run without writing a vault file to disk.
# HASP_EPHEMERAL=1

# Port. Overridden by --port=.
# PORT=3000
